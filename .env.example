# Copy to .env and fill in locally. Never commit real secrets.

# Preferred for automation (CI / headless):
# One-time: higgsfield auth login
# Then: cat ~/.config/higgsfield/credentials.json
HIGGSFIELD_CREDENTIALS_FILE=/absolute/path/to/.higgsfield_credentials.json
# Or paste the JSON inline:
# HIGGSFIELD_CREDENTIALS={"auth_version":2,"access_token":"...","refresh_token":"...","expires_at":0,"token_type":"bearer","scope":"..."}

# Workspace used for Marketing Studio billing/credits
HIGGSFIELD_WORKSPACE_ID=your-workspace-uuid

# Optional Playwright fallback (email/password accounts only — NOT Google SSO)
# HIGGSFIELD_EMAIL=you@company.com
# HIGGSFIELD_PASSWORD=...
# HIGGSFIELD_OAUTH_PORT=8765
